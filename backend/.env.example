# Шаблон локальных переменных. Скопируйте в backend/.env —
# он в .gitignore и в репозиторий не попадёт.
#
#   copy backend\.env.example backend\.env
#
# На Render этого файла нет: там переменные задаются в разделе Environment,
# и уже заданное окружение всегда важнее содержимого .env.

# Локальный PostgreSQL из docker-compose.yml в корне проекта.
# Удалите обе строки, чтобы вернуться на SQLite.
DATABASE_URL=postgresql://kazdemeu:localdev@127.0.0.1:5432/kazdemeu
DATABASE_SSL=0

# Ключ подписи сессий и JWT. Локально можно оставить пустым —
# подставится небезопасное значение по умолчанию. На проде обязателен.
# DJANGO_SECRET_KEY=

# 1 — подробные страницы ошибок. На проде строго 0.
DJANGO_DEBUG=1

# Ключ AI-ассистента. Без него ассистент вернёт сообщение об ошибке.
# ANTHROPIC_API_KEY=
